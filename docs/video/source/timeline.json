{
 "s": {
  "intro-0": {
   "t": 1.1,
   "d": 1.872,
   "text": "Nob Pay."
  },
  "intro-1": {
   "t": 3.392,
   "d": 4.224,
   "text": "L’argent de la diaspora, libéré étape par étape, sur preuve."
  },
  "probleme-0": {
   "t": 10.216,
   "d": 4.728,
   "text": "Chaque année, la diaspora envoie plus de cent vingt-quatre milliards de dollars vers l’Afrique."
  },
  "probleme-1": {
   "t": 15.364,
   "d": 7.752,
   "text": "Dans le monde, seul un quart des transferts finance un logement, la santé, l’éducation ou un commerce, et cet argent repose sur la confiance."
  },
  "probleme-2": {
   "t": 23.536,
   "d": 2.4,
   "text": "Un virement prouve que l’argent est parti."
  },
  "probleme-3": {
   "t": 26.356,
   "d": 1.872,
   "text": "Pas que la maison existe."
  },
  "principe-0": {
   "t": 30.728,
   "d": 2.616,
   "text": "Nob Pay répond avec un principe simple."
  },
  "principe-1": {
   "t": 33.764,
   "d": 7.2,
   "text": "L’argent reste en séquestre. Il est libéré étape par étape, seulement sur preuve, et versé directement au fournisseur."
  },
  "principe-2": {
   "t": 41.384,
   "d": 5.4,
   "text": "Financer. Prouver. Valider. Payer. Vérifier."
  },
  "principe-3": {
   "t": 47.204,
   "d": 2.352,
   "text": "Voyons les parcours, un par un."
  },
  "financeur-0": {
   "t": 52.056,
   "d": 2.52,
   "text": "Premier parcours : le financeur."
  },
  "financeur-1": {
   "t": 54.996,
   "d": 6.696,
   "text": "Moussa vit en France. Il crée son compte avec son numéro de téléphone, et confirme avec un code reçu par SMS."
  },
  "financeur-2": {
   "t": 62.112,
   "d": 5.04,
   "text": "Aussitôt, il arrive sur son tableau de bord. Pour l’instant, il est vide."
  },
  "projet-0": {
   "t": 67.952,
   "d": 3.576,
   "text": "Il crée son premier projet : une maison familiale à Thiès."
  },
  "projet-1": {
   "t": 71.948,
   "d": 6.888,
   "text": "Il choisit un secteur, immobilier, agricole ou commerce, puis un nom, une ville et un budget de vingt-quatre mille dollars."
  },
  "projet-2": {
   "t": 79.256,
   "d": 5.832,
   "text": "Nob Pay propose des étapes, qu’il peut modifier. La somme des étapes doit être égale au budget."
  },
  "projet-3": {
   "t": 85.508,
   "d": 5.28,
   "text": "Puis il désigne la personne de confiance sur place, et choisit qui valide les paiements : lui seul."
  },
  "projet-4": {
   "t": 91.208,
   "d": 4.152,
   "text": "Le projet est prêt. Aucune étape n’est payée tant que rien n’est prouvé."
  },
  "financement-0": {
   "t": 96.16,
   "d": 3.72,
   "text": "Pour financer, Moussa saisit un montant : six mille dollars."
  },
  "financement-1": {
   "t": 100.3,
   "d": 4.248,
   "text": "Il paie une facture Bitcoin Lightning, depuis n’importe quel portefeuille."
  },
  "financement-2": {
   "t": 104.968,
   "d": 8.064,
   "text": "Ici, en démonstration, le paiement est simulé. Bitnob confirme par une notification signée, et le séquestre est crédité."
  },
  "financement-3": {
   "t": 113.452,
   "d": 3.792,
   "text": "La première étape s’ouvre : la vérification du titre foncier."
  },
  "terrain-0": {
   "t": 119.744,
   "d": 2.952,
   "text": "Deuxième parcours : la personne sur place."
  },
  "terrain-1": {
   "t": 123.116,
   "d": 5.568,
   "text": "Moussa envoie un lien privé à Mamadou, sur WhatsApp. Mamadou n’a aucun compte à créer."
  },
  "terrain-2": {
   "t": 129.104,
   "d": 3.576,
   "text": "Il ouvre le lien sur son téléphone, et voit l’étape à faire."
  },
  "terrain-3": {
   "t": 133.1,
   "d": 4.8,
   "text": "Il photographie le titre foncier : la position de son téléphone est jointe à la photo."
  },
  "terrain-4": {
   "t": 138.32,
   "d": 5.736,
   "text": "Il indique qui doit être payé : le nom du géomètre, son numéro mobile money, son opérateur."
  },
  "terrain-5": {
   "t": 144.476,
   "d": 2.472,
   "text": "Il envoie la preuve. C’est tout."
  },
  "decision-0": {
   "t": 149.448,
   "d": 4.944,
   "text": "Retour au financeur. Une alerte l’informe : une preuve attend sa décision."
  },
  "decision-1": {
   "t": 154.812,
   "d": 5.064,
   "text": "Il regarde la photo géolocalisée, le fournisseur à payer, le message de Mamadou."
  },
  "decision-2": {
   "t": 160.296,
   "d": 6.312,
   "text": "Si la preuve ne convient pas, il peut la refuser, en précisant pourquoi. Rien n’est payé sans son accord."
  },
  "decision-3": {
   "t": 167.028,
   "d": 9.744,
   "text": "Sinon, il libère le paiement. Nob Pay affiche le devis : le montant débité, le taux, les frais, et ce que le fournisseur recevra : neuf cent douze mille francs CFA."
  },
  "decision-4": {
   "t": 177.192,
   "d": 5.712,
   "text": "Il confirme. Le paiement part directement vers le mobile money du fournisseur, via Bitnob."
  },
  "decision-5": {
   "t": 183.324,
   "d": 5.712,
   "text": "La confirmation arrive par une notification signée : l’étape est payée, et la suivante peut s’ouvrir."
  },
  "fournisseur-0": {
   "t": 191.536,
   "d": 2.616,
   "text": "Troisième parcours : le fournisseur."
  },
  "fournisseur-1": {
   "t": 194.572,
   "d": 2.976,
   "text": "Il reçoit un lien de reçu, sans compte à créer."
  },
  "fournisseur-2": {
   "t": 197.968,
   "d": 8.064,
   "text": "Il y voit le montant en francs CFA, l’état du paiement, la date, et une référence. Son numéro de téléphone est partiellement masqué."
  },
  "preuve-0": {
   "t": 208.532,
   "d": 2.424,
   "text": "Quatrième parcours : la preuve."
  },
  "preuve-1": {
   "t": 211.376,
   "d": 5.568,
   "text": "Chaque événement du projet entre dans un registre enchaîné : modifier une seule ligne casserait toute la suite."
  },
  "preuve-2": {
   "t": 217.364,
   "d": 7.056,
   "text": "Moussa peut ancrer l’empreinte de ce registre sur Bitcoin, avec OpenTimestamps. Seule l’empreinte quitte l’application."
  },
  "preuve-3": {
   "t": 224.84,
   "d": 5.976,
   "text": "Et n’importe qui peut ensuite vérifier le dossier, sans compte : le navigateur refait lui-même tous les calculs."
  },
  "admin-0": {
   "t": 233.316,
   "d": 2.832,
   "text": "Dernier parcours : l’administrateur."
  },
  "admin-1": {
   "t": 236.568,
   "d": 4.872,
   "text": "Son tableau de bord est en lecture seule : les paiements, les versements, les ancrages."
  },
  "admin-2": {
   "t": 241.86,
   "d": 6.576,
   "text": "Et des alertes, si un paiement se bloque ou si un ancrage tarde. Il voit tout, mais il ne déplace jamais d’argent."
  },
  "bitnob-0": {
   "t": 250.936,
   "d": 3.408,
   "text": "Sous le capot, l’API Bitnob fait circuler l’argent."
  },
  "bitnob-1": {
   "t": 254.764,
   "d": 7.848,
   "text": "Des factures Lightning à l’entrée, une conversion en stablecoin, des paiements mobile money en sortie, et des webhooks signés pour confirmer chaque étape."
  },
  "bitnob-2": {
   "t": 263.032,
   "d": 3.552,
   "text": "Bitnob déplace l’argent. Nob Pay décide quand."
  },
  "outro-0": {
   "t": 269.084,
   "d": 3.792,
   "text": "Nob Pay. Investir au pays, avec preuve."
  },
  "outro-1": {
   "t": 273.296,
   "d": 1.872,
   "text": "Merci."
  }
 },
