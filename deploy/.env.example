# Copy to deploy/.env and fill in. This file is read by Docker Compose; NEVER commit the real one.

# --- public address ---------------------------------------------------------
SITE_ADDRESS=demo.example.org
PUBLIC_BASE_URL=https://demo.example.org

# --- secrets (generate: openssl rand -hex 32) --------------------------------
SESSION_SECRET=
BITNOB_WEBHOOK_SECRET=

# --- profile -----------------------------------------------------------------
# DEMO instance (judges can try it, fake data only): ALLOW_DEMO=1, BITNOB_MODE=mock (or sandbox)
# PILOT instance (real people, real sats): ALLOW_DEMO=0 and a real way to sign in (SMS_PROVIDER=twilio ...)
# REAL-SATS instance (judges try it with a few real sats): LIGHTNING_RAIL=nwc, ALLOW_DEMO=0, ALLOW_GUEST=1 (see below)
ALLOW_DEMO=1
BITNOB_MODE=mock
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=

# --- real bitcoin (Lightning through Nostr Wallet Connect) ----------------------
# Fill these three and set ALLOW_DEMO=0, ALLOW_GUEST=1: the server refuses to start with LIGHTNING_RAIL=nwc and ALLOW_DEMO on.
# The connection strings are secrets: they live here, never in Git, never in a chat.
LIGHTNING_RAIL=
NWC_RECEIVE_URL=
NWC_PAYOUT_URL=
LIGHTNING_MAX_FUNDING_USD=100
LIGHTNING_MAX_PAYOUT_USD=100
LIGHTNING_MAX_ESCROW_USD=500
ALLOW_GUEST=

# --- sign-in by SMS (pilot) ---------------------------------------------------
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DAILY_CAP=300

# --- Nostr: the ledger replicated on public relays ----------------------------
# Back NOSTR_MASTER_KEY up (openssl rand -hex 32): it alone lets the instance keep signing for existing projects.
NOSTR_PUBLISH=1
NOSTR_MASTER_KEY=
NOSTR_RELAYS=

# --- option ------------------------------------------------------------------
AUTO_ANCHOR=1
FUNDING_INVOICE_TTL_SECONDS=3600
TRUSTED_PROXY_HOPS=1
ADMIN_PHONES=
