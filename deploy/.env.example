# Copy to deploy/.env and fill in. This file is read by Docker Compose; NEVER commit the real one.

# --- public address ---------------------------------------------------------
SITE_ADDRESS=demo.example.org
PUBLIC_BASE_URL=https://demo.example.org

# --- secrets (generate: openssl rand -hex 32) --------------------------------
SESSION_SECRET=
BITNOB_WEBHOOK_SECRET=

# --- profile -----------------------------------------------------------------
# DEMO instance (judges can try it, fake data only): ALLOW_DEMO=1, BITNOB_MODE=mock (or sandbox)
# PILOT instance (real people, real sats): ALLOW_DEMO=0 and a real way to sign in (SMS_PROVIDER=twilio ...)
ALLOW_DEMO=1
BITNOB_MODE=mock
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=

# --- sign-in by SMS (pilot) ---------------------------------------------------
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DAILY_CAP=300

# --- option ------------------------------------------------------------------
AUTO_ANCHOR=1
FUNDING_INVOICE_TTL_SECONDS=3600
TRUSTED_PROXY_HOPS=1
ADMIN_PHONES=
