# ---------------------------------------------------------------------------
# NobPay : copy this file to .env.local and fill it in. NEVER commit .env.local
# ---------------------------------------------------------------------------

# mock    = everything simulated locally (default, works offline, safe for demos)
# sandbox = real calls to the Bitnob API with your sandbox keys
BITNOB_MODE=mock

# Same host for sandbox and production: the key you use decides the environment.
BITNOB_BASE_URL=https://api.bitnob.com

# Bitnob dashboard (sandbox mode) -> Settings -> API keys
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=

# Bitnob dashboard -> Webhooks -> "Signing secret" (you choose it when creating the webhook)
# Webhook URL to register: <PUBLIC_BASE_URL>/api/webhooks/bitnob  (must be public HTTPS)
BITNOB_WEBHOOK_SECRET=

# Largest step amount (dollars) a project may have. Default: 330 in sandbox (Bitnob refuses a Senegal mobile money
# payout above 200 000 XOF, about 336 $), no limit in mock mode. 0 turns the check off.
MAX_STEP_USD=

# Background loop (payouts, invoices, anchors) is on by default. BACKGROUND_JOBS=0 turns it off.
BACKGROUND_JOBS=
# 1 = anchor a project on Bitcoin (OpenTimestamps) right after a payout completes or a funding is credited.
# Opt-in: it calls public calendars over the network. Pending anchors are then confirmed by the loop by themselves.
AUTO_ANCHOR=

# Rate limiting is on by default (see src/server/rateLimit.ts). RATE_LIMIT=0 turns it off (tests only).
# TRUSTED_PROXY_HOPS = how many proxies sit in front of the app (default 1: a tunnel or one load balancer).
RATE_LIMIT=
TRUSTED_PROXY_HOPS=

# Memory the proof uploads may hold at the same moment, in MB (default 48, made for a 512 MB instance). One upload is always
# accepted; another one that would go over gets a 503 "try again in a few seconds". Raise it on a bigger server (160 on 2 GB).
UPLOAD_MEMORY_MB=

# Set to 1 to save every webhook delivery (headers with the signature masked + raw body) in
# .data/webhook-captures/. Sandbox debugging only; the folder is ignored by Git.
CAPTURE_WEBHOOKS=

# Public URL of this app (used for webhook and verification links).
# For local tests, expose port 3000 with a tunnel (e.g. cloudflared) and put its URL here.
PUBLIC_BASE_URL=http://localhost:3000

# Signs the session cookie. At least 32 random characters, e.g.:  openssl rand -hex 32
# REQUIRED in sandbox mode (the server refuses to start with a missing, default or short value).
# Optional in mock mode (a public default is used: fine for a local demo only).
SESSION_SECRET=

# Demo conveniences: the "demo account" button, the one-for-all SMS code (DEMO_OTP), the data reset and the
# simulated payments. Empty = allowed in mock mode only. 1 = allowed (also in sandbox: anyone who knows a
# phone number can then open that account, keep it for demos in front of people you trust). 0 = refused.
# There is no SMS provider yet: with demo off nobody can sign in.
ALLOW_DEMO=

# SMS sign-in codes. Empty = no provider: only the shared demo code exists (and only if ALLOW_DEMO permits).
#   log    = codes are printed in the SERVER console (development only)
#   twilio = real SMS, needs the three TWILIO_* values
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Back-office (/app/admin): phone numbers allowed to open it, comma separated, e.g. +33612345678,+221771234567.
# In demo mode the demonstration account can open it too. The page is read-only.
# These numbers only get the whole-database view when the sign-in code is sent to the phone (SMS_PROVIDER set): while the
# code is the shared demo code, anybody who knows a number could sign in as it, so the view is refused (and a warning is logged).
ADMIN_PHONES=
# Demo-only shared SMS code. Used only when no SMS provider is configured and demo is allowed.
DEMO_OTP=123456

# ---------------------------------------------------------------------------
# REAL BITCOIN over Lightning (Nostr Wallet Connect, NIP-47). Leave empty for the simulated / Bitnob sandbox modes.
# ---------------------------------------------------------------------------
# nwc = funders pay a real Lightning invoice, suppliers are paid in sats at their Lightning address, unused escrow can be
# refunded. This turns the whole instance "serious": it REQUIRES a strong SESSION_SECRET and ALLOW_DEMO=0 (the server
# refuses to start otherwise), and suppliers can only be paid by Lightning address (no mobile money on such an instance).
LIGHTNING_RAIL=
# RECEIVE connection (nostr+walletconnect://...): create it in your wallet with ONLY these rights: make invoices, look
# them up, read balance. It cannot spend, so a leaked string cannot empty the wallet.
NWC_RECEIVE_URL=
# PAYOUT connection: the only one that can spend (pay suppliers, refunds). Give it a budget in the wallet (for example
# 50 $ per day). Empty = payments and refunds are off, funding still works. May point at the same wallet as the receive one.
NWC_PAYOUT_URL=
# Pilot ceilings, in dollars: one funding, one payment to a supplier, and all real escrow of the instance together.
LIGHTNING_MAX_FUNDING_USD=100
LIGHTNING_MAX_PAYOUT_USD=100
LIGHTNING_MAX_ESCROW_USD=500
# 1 = "Try without an account": a private guest account per visitor (no phone number, never an administrator).
# This is how a jury tries a real-bitcoin instance, since ALLOW_DEMO must be 0 there.
ALLOW_GUEST=
# How long a funding invoice can be paid (seconds, 300 to 86400, default 3600): the escrow is credited in dollars and the
# bitcoin price moves.
FUNDING_INVOICE_TTL_SECONDS=
# Largest number of sign-in SMS the instance sends per day (default 300).
SMS_DAILY_CAP=

# ---------------------------------------------------------------------------
# NOSTR: commitments of the ledger on public relays (opt-in, only hashes leave the machine)
# ---------------------------------------------------------------------------
# 1 = each ledger event is published to the relays as a small signed Nostr event (kind 8421: position + two hashes, no name,
# no amount), by a key made for the project. Anyone can then check, from their browser, that the ledger was not rewritten.
# Only projects created while this is on get commitments (the key is named in their first ledger event).
NOSTR_PUBLISH=
# Secret from which every project's signing key is derived: openssl rand -hex 32. BACK IT UP: it alone lets the instance
# keep signing for existing projects. Without it, keys come from SESSION_SECRET (fine for a demo, a change of that secret
# would change every key).
NOSTR_MASTER_KEY=
# Relays, comma separated, wss:// only. Default: relay.damus.io, nos.lol, relay.primal.net. Check them with
# `node scripts/nostr-smoke.mjs` (it publishes one test event: read the header of the script first).
NOSTR_RELAYS=
# How many relays must accept a commitment before it counts as published (default 2, or all if fewer are configured).
NOSTR_MIN_ACKS=
# With NOSTR_PUBLISH=1, the id of the commitments where money moved is also stamped on Bitcoin (NIP-03, OpenTimestamps)
# and the proof is published as a kind 1040 event. 0 turns that off.
NOSTR_ATTEST=

# ---------------------------------------------------------------------------
# AI: a second opinion on the proof of a step (opt-in, consultative, never blocks or triggers a payment)
# ---------------------------------------------------------------------------
# 1 = the funder can ask Claude to look at the photos and read the invoice of a proof. WHEN ASKED, the photos and the invoice
# of that proof (and the step title, amount, supplier name and field note; nothing about the funder) are sent to the
# Anthropic API. Each review costs money: SET A SPENDING LIMIT on the key in the Anthropic Console.
AI_REVIEW=
ANTHROPIC_API_KEY=
# Default claude-opus-5-5. A cheaper model reads photos and invoices well too (for example claude-haiku-5-5); try both on a
# few real proofs and keep the one whose advice you trust.
AI_MODEL=
# Reviews the whole instance may run in 24 hours (default 50). A funder is also limited to 10 per hour.
AI_DAILY_CAP=

# ---------------------------------------------------------------------------
# Notifications on the phone (Web Push), optional
# ---------------------------------------------------------------------------
# `node scripts/vapid-keys.mjs` makes the pair. The private key stays on the server; without the pair the feature is off.
# The server refuses to start with a malformed key or subject.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:you@example.org, or an https address the push services can reach in case of trouble
VAPID_SUBJECT=
# 0 = off even when the keys are set
PUSH=

# The dollar in FCFA is computed every 30 minutes from public prices (1 EUR = 655.957 XOF). 0 = never call them.
# USD_XOF_RATE, when set, always wins.
LIVE_FX=

# Smallest project budget in dollars. Default: 100 on the Bitnob sandbox, 10 elsewhere (so the "essai rapide", a 15 $
# project in 3 steps, exists on the demo and on the real-bitcoin instance).
MIN_BUDGET_USD=

# Indicative rates used in mock mode and as fallbacks (XOF per dollar: about 593 at Bitnob on 18 Oct. 2026).
USD_XOF_RATE=593
BTC_USD_RATE=81500
