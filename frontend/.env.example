# ---------------------------------------------------------------------------
# NobPay : copy this file to .env.local and fill it in. NEVER commit .env.local
# ---------------------------------------------------------------------------

# mock    = everything simulated locally (default, works offline, safe for demos)
# sandbox = real calls to the Bitnob API with your sandbox keys
BITNOB_MODE=mock

# Same host for sandbox and production: the key you use decides the environment.
BITNOB_BASE_URL=https://api.bitnob.com

# Bitnob dashboard (sandbox mode) -> Settings -> API keys
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=

# Bitnob dashboard -> Webhooks -> "Signing secret" (you choose it when creating the webhook)
# Webhook URL to register: <PUBLIC_BASE_URL>/api/webhooks/bitnob  (must be public HTTPS)
BITNOB_WEBHOOK_SECRET=

# Public URL of this app (used for webhook and verification links).
# For local tests, expose port 3000 with a tunnel (e.g. cloudflared) and put its URL here.
PUBLIC_BASE_URL=http://localhost:3000

# Signs the demo session cookie. Any long random string.
SESSION_SECRET=change-me

# Demo-only SMS code (there is no SMS provider in this prototype).
DEMO_OTP=123456

# Indicative rates used in mock mode and as fallbacks.
USD_XOF_RATE=760
BTC_USD_RATE=81500
